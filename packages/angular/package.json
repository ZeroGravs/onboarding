{
  "name": "@onboarding/angular",
  "version": "0.1.0",
  "description": "Standalone Angular adapters for Onboarding Kit",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node scripts/copy-assets.mjs",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit",
    "check:package": "publint dist && attw --pack dist --profile esm-only --ignore-rules cjs-resolves-to-esm",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@onboarding/core": "workspace:^",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": ">=21.2.26 <22",
    "@angular/core": ">=21.2.26 <22",
    "@angular/router": ">=21.2.26 <22",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-browser-dynamic": "21.2.26",
    "@angular/router": "21.2.26",
    "ng-packagr": "21.2.7",
    "rxjs": "^7.8.2",
    "typescript": "~5.9.3",
    "zone.js": "~0.16.0"
  }
}
